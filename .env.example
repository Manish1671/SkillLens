# PostgreSQL (docker-compose)
POSTGRES_USER=skilllens
POSTGRES_PASSWORD=skilllens
POSTGRES_DB=skilllens
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Backend
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg://skilllens:skilllens@localhost:5432/skilllens
TEST_DATABASE_URL=postgresql+psycopg://skilllens:skilllens@localhost:5432/skilllens_test

# Auth — CHANGE IN PRODUCTION (32+ random characters)
JWT_SECRET_KEY=dev-only-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Optional: comma-separated origins when frontend and API are on different hosts
# CORS_ORIGINS=https://app.example.com

# Frontend (Next.js rewrite target at build/dev time)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Production Docker / Render: server-side rewrite target (not the browser origin)
# API_URL=http://backend:8000

# Hosted platforms set PORT automatically
# PORT=8000

# Demo account (used only by `python -m app.seed.demo`)
# SKILLENS_DEMO_PASSWORD=

# Production checklist:
# - APP_ENV=production
# - JWT_SECRET_KEY=<strong random secret, 32+ characters>
# - Secure cookies enabled automatically when APP_ENV=production
# - HTTPS in front of the app (Render / Railway / a reverse proxy)
# - Run: alembic upgrade head (the Docker start script does this)
# - Seed catalog + demo: python -m app.seed && python -m app.seed.demo
